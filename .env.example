ADMIN_KEY=replace-with-a-long-random-password
STUDENT_KEY=replace-with-a-different-long-random-password
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://najmuni.com,https://www.najmuni.com
ANTHROPIC_API_KEY=
VITE_API_URL=
# For the hosted static frontend, use:
# VITE_API_URL=https://api.najmuni.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=
DB_PATH=../data/najmuni.db
DATABASE_URL=
# For Render Starter + Persistent Disk, use:
# DB_PATH=/var/data/najmuni.db
#
# PostgreSQL uses DATABASE_URL when configured. Keep credentials private.
FLASK_DEBUG=false
