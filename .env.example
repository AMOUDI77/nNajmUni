ADMIN_KEY=replace-with-a-long-random-password
STUDENT_KEY=replace-with-a-different-long-random-password
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://najmuni.com,https://www.najmuni.com
ANTHROPIC_API_KEY=
VITE_API_URL=
# For the hosted static frontend, use:
# VITE_API_URL=https://api.najmuni.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=
DB_PATH=../data/najmuni.db
DATABASE_URL=
# For Render Starter + Persistent Disk, use:
# DB_PATH=/var/data/najmuni.db
#
# PostgreSQL uses DATABASE_URL when configured. Keep credentials private.
FLASK_DEBUG=false

# CRM: production defaults to secure cookies. Local development only:
CRM_ENV=production
CRM_ALLOWED_ORIGINS=https://najmuni.com,https://www.najmuni.com
CRM_PUBLIC_URL=https://najmuni.com
CRM_CLAUDE_MODEL=claude-haiku-4-5-20251001
# Instagram Login (server-only secrets; never use VITE_ prefixes)
META_PROVIDER_MODE=live
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=
META_INSTAGRAM_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_TOKEN_ENCRYPTION_KEY=
