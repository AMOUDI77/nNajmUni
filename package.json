{
  "name": "najmuni",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev --prefix client\"",
    "dev:server": "cd server && flask --app app run --host 0.0.0.0 --port 5000",
    "build": "npm run build --prefix client",
    "install:all": "npm install --prefix client && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
